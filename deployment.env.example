GEMINI_API_KEY=replace_in_secret_manager
JEV_KEY=
JEV_MODEL=jev-latest
JEV_VERIFICATION_MODE=shadow
JEV_RERANK_MODE=shadow
JEV_REWRITE_MODE=shadow
JEV_ROUTING_MODE=shadow
JEV_PLANNING_MODE=shadow
JEV_HISTORY_MODE=shadow
JEV_CLASSIFICATION_MODE=shadow
JEV_EXTRACTION_MODE=shadow
# active uses one task owner. closed prevents an LLM retry after Jev transport/schema failure.
JEV_ACTIVE_FAILURE_POLICY=closed
JEV_RAG_LAB_EXTRACTION_POLICY=warn
JEV_APPROVAL_THRESHOLD=0.99
JEV_TIMEOUT_SECONDS=8
JEV_INPUT_USD_PER_MILLION=0.042
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_DIRECT_MODEL=gemini-3.5-flash-lite
GEMINI_COMPLEX_MODEL=gemini-3.8-flash
GEMINI_UTILITY_MODEL=gemini-3.5-flash-lite
GEMINI_VERIFICATION_MODEL=gemini-3.5-flash-lite
GEMINI_DIRECT_THINKING_LEVEL=minimal
GEMINI_COMPLEX_THINKING_LEVEL=medium
GEMINI_COMPLEX_HIGH_THINKING_LEVEL=high
GEMINI_DIRECT_MAX_OUTPUT_TOKENS=1800
GEMINI_COMPLEX_MAX_OUTPUT_TOKENS=4000
# Combined thinking + answer allowance; independent of the medium-reasoning cap.
GEMINI_COMPLEX_HIGH_MAX_OUTPUT_TOKENS=8192
# One regeneration at up to twice the original budget, capped here.
GEMINI_TRUNCATION_RECOVERY=true
GEMINI_TRUNCATION_MAX_OUTPUT_TOKENS=16384
EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_REQUEST_INTERVAL_MS=250
GEMINI_GENERATION_REQUEST_INTERVAL_MS=0
GEMINI_EMBEDDING_MAX_RETRIES=7
GEMINI_EMBEDDING_RETRY_BASE_SECONDS=2
GEMINI_EMBEDDING_RETRY_MAX_SECONDS=60
GEMINI_EMBEDDING_DEADLINE_SECONDS=300
GEMINI_GENERATION_MAX_RETRIES=3
GEMINI_GENERATION_RETRY_BASE_SECONDS=1
GEMINI_GENERATION_RETRY_MAX_SECONDS=15
GEMINI_GENERATION_DEADLINE_SECONDS=150
RAG_DIRECT_CANDIDATES=50
RAG_DIRECT_ANCHORS=4
RAG_DIRECT_CONTEXTS=5
RAG_DIRECT_CONTEXT_TOKENS=3000
RAG_PROCEDURE_CANDIDATES=80
RAG_PROCEDURE_ANCHORS=6
RAG_PROCEDURE_CONTEXTS=8
RAG_PROCEDURE_CONTEXT_TOKENS=5000
RAG_COMPARISON_CANDIDATES=100
RAG_COMPARISON_ANCHORS=8
RAG_COMPARISON_CONTEXTS=10
RAG_COMPARISON_CONTEXT_TOKENS=7000
RAG_OVERVIEW_CANDIDATES=120
RAG_OVERVIEW_ANCHORS=8
RAG_OVERVIEW_CONTEXTS=12
RAG_OVERVIEW_CONTEXT_TOKENS=8000
RAG_TEMPORAL_CANDIDATES=120
RAG_TEMPORAL_ANCHORS=8
RAG_TEMPORAL_CONTEXTS=12
RAG_TEMPORAL_CONTEXT_TOKENS=8000
RETRIEVAL_MAX_PER_SOURCE=0
RETRIEVAL_DUPLICATE_THRESHOLD=0.82
RETRIEVAL_EXPAND_NEIGHBORS=true
RETRIEVAL_MIN_CONTEXT_SCORE=0.0
RETRIEVAL_CONFIDENCE_THRESHOLD=0.01
RAG_MULTI_QUERY=true
RAG_MULTI_QUERY_MAX=4
RAG_EVIDENCE_PLANNING=true
RAG_ANSWER_VERIFICATION=true
# Audit all evidence; return the full answer only when corrections are needed.
RAG_COMPACT_VERIFICATION=true
# Re-audit rejected/inconsistent Lite verdicts once with the complex model.
RAG_VERIFICATION_ESCALATION=true
RAG_INDEX_VERSION=4

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_in_secret_manager

JWT_SECRET_KEY=replace_with_long_random_jwt_secret
JWT_EXPIRES_MINUTES=1440
REFRESH_TOKEN_EXPIRES_DAYS=30
AUTH_DISABLED=false
CORS_ALLOWED_ORIGINS=https://pilot-frontend.example.gov.in
VALIDATE_CONFIG_ON_STARTUP=true
LOG_LEVEL=INFO

ALLOWED_UPLOAD_EXTENSIONS=pdf,txt,docx,ppt,pptx
UPLOAD_MAX_BYTES=157286400
UPLOAD_BATCH_MAX_BYTES=157286400
UPLOAD_BATCH_MAX_FILES=50
ALLOW_DOCUMENT_REPLACE=false
DOCUMENT_STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fisrag-docs
R2_PREFIX=docs/
R2_UPLOAD_STAGING_PREFIX=pending-uploads/
PRESIGNED_UPLOAD_EXPIRES_SECONDS=900
PDF_EXTRACT_TABLES=false
DOCUMENT_AI_OCR_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
DOCUMENT_AI_LOCATION=asia-south1
DOCUMENT_AI_PROCESSOR_ID=
DOCUMENT_AI_OCR_LANGUAGE_HINTS=en,hi
DOCUMENT_AI_OCR_MIN_TEXT_CHARS=40
DOCUMENT_AI_OCR_MAX_PAGES=200
DOCUMENT_AI_OCR_TIMEOUT_SECONDS=60
DOCUMENT_AI_OCR_RETRY_ATTEMPTS=3
DOCUMENT_AI_OCR_MAX_REQUEST_BYTES=40000000
MAX_PDF_PAGES=500
MAX_EXTRACTED_CHARS=15000000
MAX_DOCUMENT_CHUNKS=3000
INGEST_BATCH_SIZE=24

CELERY_BROKER_URL=rediss://default:replace_with_redis_cloud_password@replace-with-redis-cloud-host:6379/0?ssl_cert_reqs=required
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BASE_SECONDS=60
CELERY_REQUIRE_WORKER_ONLINE=true
CELERY_WORKER_PING_TIMEOUT_SECONDS=2

CHUNK_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
MAX_UNIT_TOKENS=220
FAQ_CHUNK_TOKENS=650
FAQ_CHUNK_OVERLAP_TOKENS=80
FAQ_UNIT_TOKENS=260
PROCEDURE_CHUNK_TOKENS=600
PROCEDURE_CHUNK_OVERLAP_TOKENS=120
PROCEDURE_UNIT_TOKENS=260

# Cost policy: false restores unconditional broad-question planning and full recent history.
RAG_COST_OPTIMIZATIONS=true
RAG_SELECTIVE_PLANNING=true
RAG_SELECTIVE_HISTORY=true
RAG_SELECTIVE_EVIDENCE=true
RAG_SELECTIVE_REASONING=true
RAG_SELECTIVE_VERIFICATION=true
RAG_HISTORY_SELECTION_TOKENS=1500
GEMINI_CONTEXT_REWRITE_MAX_OUTPUT_TOKENS=600
# Illustrative conversion for generation-cost telemetry; set to your billing FX rate.
COST_USD_TO_INR=90
# Advisory telemetry threshold, never a silent answer truncation or quality bypass.
COST_QUERY_MAX_INR=1.5

# Keep disabled until legal hierarchy has passed dev/SME validation.
RAG_LEGAL_HIERARCHY=false
LEGAL_REGISTRY_NAMESPACE=prod
LEGAL_REGISTRY_WRITES_ENABLED=false

# Selective routing rollout: opt in on dev after reviewing the synthetic comparison.
RAG_LITE_EXTRACTION=false
RAG_RISK_BASED_VERIFICATION=false
RAG_LEGAL_BATCH_EMBEDDINGS=false
# Optional verified embedding pricing. Missing provider token usage/rate stays unknown.
# COST_EMBEDDING_RATE_MODEL=gemini-embedding-2
# COST_EMBEDDING_USD_PER_MILLION_TOKENS=<verified-rate>

# P1 security: apply migrations/012_auth_security.sql before deploying.
APP_ENV=production
RATE_LIMIT_ENABLED=true
# Optional separate Redis; defaults to REDIS_URL / CELERY_BROKER_URL.
SECURITY_REDIS_URL=
REQUEST_MAX_BYTES=1048576
AUTH_REQUEST_MAX_BYTES=16384
REQUEST_HEADERS_MAX_BYTES=32768
REQUEST_TARGET_MAX_BYTES=8192
REQUEST_BODY_TIMEOUT_SECONDS=120
LIMIT_LEASE_SECONDS=120
LIMIT_WORKER_GLOBAL_CONCURRENCY=2
# Full per-bucket rate/concurrency settings: docs/security_rollout.md
