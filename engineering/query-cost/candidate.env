# Evaluation manifest only. Do not copy unrelated production secrets or automatically deploy.
# Apply these overrides in an isolated evaluation process, preserving existing provider models.
RAG_ROUTING_POLICY=jev-led-v1
JEV_ROUTING_MODE=active
JEV_ROUTE_THRESHOLD=0.80
JEV_ROUTE_MARGIN=0.20
RAG_AUDIT_POLICY=independent-v1
RAG_EVIDENCE_COMPACTION=exact-v1
GEMINI_VERIFY_COMPLEX_MAX_OUTPUT_TOKENS=4000
GEMINI_VERIFY_COMPLEX_THINKING_LEVEL=medium
COST_ORDINARY_TARGET_INR=1.20
COST_COMPLEX_TARGET_INR=1.50
# Existing JEV_VERIFICATION_MODE / JEV_ACTIVE_FAILURE_POLICY retain their meanings.
# No cache enablement, resolver call, migration, reindex or provider switch is required.
